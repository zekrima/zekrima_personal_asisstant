# Maintainer: Zekrima
pkgname=zekrima
pkgver=0.5.0
pkgrel=1
pkgdesc="Zekrima Personal Assistant - Native Dynamic Island & AI companion for Arch Linux / CachyOS (GTK4 + Wayland Layer Shell)"
arch=('x86_64' 'aarch64')
url="https://github.com/zekrima/zekrima_personal_asisstant"
license=('MIT')
options=('!debug')
depends=(
  'gtk4'
  'gtk4-layer-shell'
  'pango'
  'cairo'
  'gdk-pixbuf2'
  'playerctl'
  'pipewire-pulse'
  'wireplumber'
  'dbus'
  'curl'
)
optdepends=(
  'grim: Zero-Retention Screen Vision on Hyprland / Sway / wlroots Wayland'
  'spectacle: Zero-Retention Screen Vision on KDE Plasma Wayland'
  'brightnessctl: AI System Control brightness adjustment'
  'wtype: Explicit Insert button auto-paste on Wayland'
  'xdotool: Active window title & Insert auto-paste fallback on X11'
)
makedepends=(
  'cargo'
  'rust'
  'pkgconf'
)

build() {
  cd "$startdir"
  export RUSTUP_TOOLCHAIN=stable
  cargo build --release --locked 2>/dev/null || cargo build --release
}

package() {
  cd "$startdir"
  install -Dm755 "target/release/zekrima" "$pkgdir/usr/bin/zekrima"
  install -Dm644 "zekrima.desktop" "$pkgdir/usr/share/applications/zekrima.desktop"
}
